{
  "name": "eterea.multitenant-client",
  "version": "0.1.0",
  "description": "Cliente Angular multiempresa de Eterea con m\u00f3dulo contable",
  "scripts": {
    "ng": "ng",
    "start": "nx serve contable",
    "start:administrador": "nx serve administrador",
    "build": "nx build contable",
    "build:administrador": "nx build administrador",
    "lint": "nx run-many -t lint",
    "format": "prettier --write .",
    "docker:build": "docker build -f docker/app.Dockerfile --build-arg APP=contable -t eterea/contable:local .",
    "docker:build:administrador": "docker build -f docker/app.Dockerfile --build-arg APP=administrador -t eterea/administrador:local ."
  },
  "private": true,
  "packageManager": "npm@11.6.2",
  "dependencies": {
    "@angular/common": "22.1.8",
    "@angular/compiler": "22.1.8",
    "@angular/core": "22.1.8",
    "@angular/forms": "22.1.8",
    "@angular/platform-browser": "22.1.8",
    "@angular/router": "22.1.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.6.4",
    "@analogjs/vitest-angular": "2.6.4",
    "@angular-devkit/core": "22.1.9",
    "@angular-devkit/schematics": "22.1.9",
    "@angular/build": "22.1.9",
    "@angular/cli": "22.1.9",
    "@angular/compiler-cli": "22.1.8",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "23.3.0",
    "@nx/devkit": "23.3.0",
    "@nx/eslint": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/vite": "23.3.0",
    "@nx/vitest": "23.3.0",
    "@nx/web": "23.3.0",
    "@nx/workspace": "23.3.0",
    "@schematics/angular": "22.1.9",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "20.19.9",
    "@vitest/coverage-v8": "~4.1.0",
    "angular-eslint": "22.5.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jsdom": "^28.0.0",
    "nx": "23.3.0",
    "postcss": "^8.5.12",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.4",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.8"
  }
}
